{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@acuario-ui-shared": ["./libs/acuario/frontend/shared/src/index.ts"],
      "@acuario-ui-shared/*": ["./libs/acuario/frontend/shared/src/lib/*"],
      "@acuario-ui-home": ["./libs/acuario/frontend/home/src/index.ts"],
      "@acuario-ui-exhibiciones": [
        "./libs/acuario/frontend/exhibiciones/src/index.ts"
      ],
      "@acuario-ui-especies": ["./libs/acuario/frontend/especies/src/index.ts"],
      "@acuario-ui-contacto": ["./libs/acuario/frontend/contacto/src/index.ts"],
      "@arias-ui-shared": ["./libs/arias/frontend/shared/src/index.ts"],
      "@arias-ui-shared/*": ["./libs/arias/frontend/shared/src/lib/*"],
      "@arias-ui-inicio": ["./libs/arias/frontend/inicio/src/index.ts"],
      "@arias-ui-sobre": ["./libs/arias/frontend/sobre/src/index.ts"],
      "@arias-ui-servicios": ["./libs/arias/frontend/servicios/src/index.ts"],
      "@arias-ui-enfoque": ["./libs/arias/frontend/enfoque/src/index.ts"],
      "@arias-ui-articulos": ["./libs/arias/frontend/articulos/src/index.ts"],
      "@arias-ui-contacto": ["./libs/arias/frontend/contacto/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
