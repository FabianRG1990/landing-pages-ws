{
  "name": "arias",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/arias/src",
  "tags": ["scope:arias"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/arias",
        "browser": "apps/arias/src/main.ts",
        "index": "apps/arias/src/index.html",
        "tsConfig": "apps/arias/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "includePaths": ["libs/arias/frontend/shared/src/lib/styles"]
        },
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/arias/public"
          }
        ],
        "styles": ["apps/arias/src/styles.scss"],
        "server": "apps/arias/src/main.server.ts",
        "outputMode": "static",
        "prerender": true
      },
      "configurations": {
        "production": {
          "budgets": [
            { "type": "initial", "maximumWarning": "1mb", "maximumError": "1.5mb" },
            { "type": "anyComponentStyle", "maximumWarning": "18kb", "maximumError": "24kb" }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": { "port": 4201 },
      "configurations": {
        "production": { "buildTarget": "arias:build:production" },
        "development": { "buildTarget": "arias:build:development" }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "arias:build",
        "port": 4201,
        "staticFilePath": "dist/apps/arias/browser",
        "spa": true
      }
    }
  }
}
